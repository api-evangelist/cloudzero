          "name": "CloudZero Post allocation telemetry records (sum)",
          "request": {
            "name": "CloudZero Post allocation telemetry records (sum)",
            "description": {
              "content": "Sends allocation telemetry data that will be summed with any existing data at the same timestamp and granularity within the stream.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "telemetry",
                "allocation",
                ":stream_name",
                "sum"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "stream_name",
                  "description": "(Required) Name of the allocation telemetry stream."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"records\": [\n    {\n      \"timestamp\": \"<dateTime>\",\n      \"value\": \"<double>\",\n      \"granularity\": \"<string>\",\n      \"element\": {\n        \"key_0\": \"<string>\",\n        \"key_1\": \"<string>\"\n      }\n    },\n    {\n      \"timestamp\": \"<dateTime>\",\n      \"value\": \"<double>\",\n      \"granularity\": \"<string>\",\n      \"element\": {\n        \"key_0\": \"<string>\"\n      }\n    }\n  ]\n}",
