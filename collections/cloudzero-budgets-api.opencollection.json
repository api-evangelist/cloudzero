          },
          "http": {
            "method": "POST",
            "url": "https://api.cloudzero.com/v2/budgets",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new budget linked to a View for tracking spend against business metrics."
