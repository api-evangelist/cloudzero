                          }
                        ],
                        "body": {
                          "mode": "raw",
                          "raw": "{\n  \"records\": [\n    {\n      \"timestamp\": \"<dateTime>\",\n      \"value\": \"<double>\",\n      \"granularity\": \"HOURLY\",\n      \"filter\": {\n        \"dolore_e12\": \"<string>\"\n      }\n    },\n    {\n      \"timestamp\": \"<dateTime>\",\n      \"value\": \"<double>\",\n      \"granularity\": \"MONTHLY\",\n      \"filter\": {\n        \"occaecatf5\": \"<string>\",\n        \"et_bba\": \"<string>\"\n      }\n    }\n  ]\n}",
                          "options": {
